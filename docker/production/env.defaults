APP_NAME="Kumuli Control Center"

API_STANDARDS_TREE=vnd
API_SUBTYPE=kumuli
API_PREFIX=api
API_VERSION=v1
API_NAME="Kumuli API"
API_DEFAULT_FORMAT=json

DB_CONNECTION=mysql
LDAP_CONNECTION=default
LDAP_PORT=389
LDAP_TIMEOUT=5
LDAP_SSL=false
LDAP_TLS=false
LDAP_OPT_PROTOCOL_VERSION=3

CASHIER_MODEL=App\Customers
CASHIER_CURRENCY=cad
CASHIER_CURRENCY_LOCALE=en_CA

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
