APP_NAME="KumuliCP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Set to "frankenphp" to serve via php artisan octane:start. Leave unset
# (or use php artisan serve / your existing web server) when not using Octane.
OCTANE_SERVER=frankenphp
# Explicit to avoid barryvdh/laravel-debugbar's IP-autodetect fallback, which
# throws under FrankenPHP/Octane's synthetic worker warm-up request (no
# REMOTE_ADDR to check).
DEBUGBAR_OPEN_STORAGE=true

API_STANDARDS_TREE=vnd
API_SUBTYPE=cp
API_PREFIX=api
API_VERSION=v1
API_NAME="API"
API_DEFAULT_FORMAT=json

PROVIDER=users
ACCOUNTMANAGER_DRIVER=db

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=kcp-mysql-1
DB_PORT=3306
DB_DATABASE=cptest
DB_USERNAME=test
DB_PASSWORD=password

LDAP_DOMAIN=example.com
LDAP_BASE_DN="dc=example,dc=com"
LDAP_LOGGING=false
LDAP_CONNECTION=default
LDAP_HOST=
LDAP_USERNAME="cn=admin,dc=example,dc=com"
LDAP_PASSWORD=
LDAP_PORT=389
LDAP_TIMEOUT=5
LDAP_SSL=false
LDAP_TLS=true  # disable (false) only for local dev — plaintext LDAP exposes credentials in transit
LDAP_OPT_PROTOCOL_VERSION=3
LDAP_ACCESS_GROUPS="cn=admin,ou=controlPanelAccess,o=server,dc=example,dc=com|cn=orgAdmin,ou=controlPanelAccess,o=server,dc=example,dc=com"
LDAP_USER_OBJECT_CLASSES=

BILLING_DRIVER=
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=  # required for webhook signature verification — set after creating the webhook endpoint in the Stripe dashboard
CASHIER_MODEL=App\Organization
CASHIER_CURRENCY=usd
CASHIER_CURRENCY_LOCALE=en_US
#CASHIER_LOGGER=stack

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
QUEUE_CONNECTION=database
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=
REDIS_PASSWORD=  # set a strong password in production — Redis must not be unauthenticated
REDIS_PORT=6379

MAIL_MAILER=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=from@example.com
MAIL_FROM_NAME=
MAIL_REPLY_TO_ADDRESS=
MAIL_REPLY_TO_NAME=

MATRIX_HOMESERVER=https://matrix.org
MATRIX_ACCESS_TOKEN=
MATRIX_ROOM_ID=!yourRoomId:matrix.org

REGISTRAR_DRIVER=

NC_API_USER=
NC_API_KEY=
NC_USERNAME=
NC_CLIENT_IP=
NC_URL=

NEXTCLOUD_HOST=
NEXTCLOUD_ADMIN_USER=
NEXTCLOUD_ADMIN_PASSWORD=

WORDPRESS_HOST=
WORDPRESS_ADMIN_USER=
WORDPRESS_ADMIN_PASSWORD=

RANCHER_HOST=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

BACKUP_ARCHIVE_PASSWORD=  # set a strong passphrase to encrypt backup archives at rest

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

WWWUSER=
WWWGROUP=
SUPERVISOR_PHP_USER=
